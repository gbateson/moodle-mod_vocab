{{!
    @template mod_vocab/game_chooser

    The games that a teacher can add to a Vocabulary activity, as tiles, in a
    popup (amd/src/managegames.js) or on game/add.php. Each tile is a link to
    the settings form for a new game of that type.

    Context variables required for this template:
    * games - name, title, description (HTML), url, hasimage, style

    Example context (json):
    {
        "games": [
            {
                "name": "quiz", "title": "Quiz", "description": "<p>A quiz of questions about the words.</p>",
                "url": "#", "hasimage": false, "style": "background-color: #bbddff; color: black;"
            }
        ]
    }
}}
<div class="vocab-games vocab-game-chooser">
    <ul class="list-unstyled d-flex flex-wrap align-items-stretch m-0 vocab-game-tiles">
        {{#games}}
        <li class="m-1">
            <a class="d-flex flex-column rounded text-decoration-none vocab-game-tile{{#hasimage}} vocab-game-has-image{{/hasimage}}"
                href="{{url}}" data-action="choosegame" data-game="{{name}}" data-gametitle="{{title}}">
                <span class="d-block vocab-game-picture" style="{{style}}"></span>
                <span class="vocab-game-band">
                    <span class="d-block vocab-game-title">{{title}}</span>
                    <span class="d-block small vocab-game-description">{{{description}}}</span>
                </span>
            </a>
        </li>
        {{/games}}
    </ul>
</div>
