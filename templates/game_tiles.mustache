{{!
    @template mod_vocab/game_tiles

    For students, a tile for each game in a Vocabulary activity: the game's
    picture if it has one (see docs/games.md), or a colour, with the title
    below it. A game that cannot be played now is greyed out, with the reason
    under its title.

    Context variables required for this template:
    * tiles - the games: title, url, disabled, reason, hasimage, style

    Example context (json):
    {
        "tiles": [
            {
                "title": "Quiz (Recognize)", "url": "#", "disabled": false, "reason": "",
                "hasimage": false, "style": "background-color: #bbddff; color: black;"
            },
            {
                "title": "Quiz (Recall)", "url": "#", "disabled": true,
                "reason": "Pass words at the earlier stages first",
                "hasimage": false, "style": "background-color: #1144ff; color: white;"
            }
        ]
    }
}}
<div class="vocab-games">
    <ul class="list-unstyled d-flex flex-wrap align-items-stretch m-0 vocab-game-tiles">
        {{#tiles}}
        <li class="m-1">
            {{^disabled}}
            <a class="d-flex flex-column rounded text-decoration-none vocab-game-tile{{#hasimage}} vocab-game-has-image{{/hasimage}}"
                href="{{url}}">
                <span class="d-block vocab-game-picture" style="{{style}}"></span>
                <span class="vocab-game-band">
                    <span class="d-block vocab-game-title">{{title}}</span>
                </span>
            </a>
            {{/disabled}}
            {{#disabled}}
            <div class="d-flex flex-column rounded vocab-game-tile vocab-game-dimmed{{#hasimage}} vocab-game-has-image{{/hasimage}}"
                aria-disabled="true">
                <span class="d-block vocab-game-picture" style="{{style}}"></span>
                <span class="vocab-game-band">
                    <span class="d-block vocab-game-title">{{title}}</span>
                    {{#reason}}<span class="d-block small vocab-game-reason">{{reason}}</span>{{/reason}}
                </span>
            </div>
            {{/disabled}}
        </li>
        {{/tiles}}
    </ul>
</div>
