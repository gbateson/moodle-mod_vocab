{{!
    @template vocabtool_dictionary/item_status

    The status of a dictionary item, its source, and the buttons that change its status.

    Context variables required for this template:
    * statusname, isdraft, isapproved, isrejected, isai, sourcename
    * hasactions, actions - itemtype, itemid, status, action, label, isapprove, isreject

    Example context (json):
    {
        "statusname": "Draft", "isdraft": true, "isai": true, "sourcename": "ChatGPT: Dictionary entry",
        "hasactions": true,
        "actions": [{"itemtype": "sense", "itemid": 7, "status": 1, "action": "approve", "label": "Approve",
                     "isapprove": true, "isreject": false}]
    }
}}
<span class="vocabtool_dictionary_status small">
    <span class="badge {{#isdraft}}badge-warning bg-warning text-dark{{/isdraft}}{{#isapproved}}badge-success bg-success{{/isapproved}}{{#isrejected}}badge-danger bg-danger{{/isrejected}}">{{statusname}}</span>
    {{#isai}}<span class="badge badge-info bg-info text-dark" title="{{sourcename}}">{{#str}} ai_generated, mod_vocab {{/str}}</span>{{/isai}}
    {{#hasactions}}
    {{#actions}}
    <button type="button" class="btn btn-sm py-0 {{#isapprove}}btn-outline-success{{/isapprove}}{{#isreject}}btn-outline-danger{{/isreject}}{{^isapprove}}{{^isreject}}btn-outline-secondary{{/isreject}}{{/isapprove}}"
            data-action="setstatus" data-itemtype="{{itemtype}}" data-itemid="{{itemid}}" data-status="{{status}}">{{label}}</button>
    {{/actions}}
    {{/hasactions}}
</span>
