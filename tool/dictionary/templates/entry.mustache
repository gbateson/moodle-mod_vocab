{{!
    @template vocabtool_dictionary/entry

    The dictionary entry of a word: its lemma, if that is another word, and the lemma's senses,
    each with its definitions, glosses and sample sentences, and each sample with its
    translations. Each item shows its status and source, and the buttons that the user may use
    to approve, reject or restore it (see vocabtool_dictionary/item_status).

    Context variables required for this template:
    * wordid, word, lemmaid, lemma, showlemma, hassenses
    * senses - see tool::export_entries()

    Example context (json):
    {
        "wordid": 3, "word": "apples", "lemmaid": 5, "lemma": "apple", "showlemma": true, "hassenses": true,
        "senses": [{
            "id": 7, "itemtype": "sense", "text": "a round fruit", "pos": "NOUN", "posname": "noun", "sensenum": 1,
            "level": "A1", "statusname": "Draft", "isdraft": true, "isai": true, "sourcename": "ChatGPT",
            "hasactions": false, "actions": [],
            "hasdefinitions": true,
            "definitions": [{"id": 8, "itemtype": "definition", "text": "A round fruit with red or green skin.",
                "level": "A2", "statusname": "Draft", "isdraft": true, "hasactions": false, "actions": []}],
            "hasglosses": true,
            "glosses": [{"id": 9, "itemtype": "definition", "text": "りんご", "langname": "Japanese",
                "statusname": "Draft", "isdraft": true, "hasactions": false, "actions": []}],
            "hassamples": true,
            "samples": [{"id": 10, "itemtype": "sample", "text": "I eat an apple every day.", "form": "apple",
                "statusname": "Draft", "isdraft": true, "hasactions": false, "actions": [],
                "hastranslations": true,
                "translations": [{"id": 11, "itemtype": "sample", "text": "私は毎日りんごを食べます。",
                    "langname": "Japanese", "statusname": "Draft", "isdraft": true, "hasactions": false, "actions": []}]
            }]
        }]
    }
}}
<div class="vocabtool_dictionary_entrybody" data-lemmaid="{{lemmaid}}">
    {{#showlemma}}
    <p class="mb-1">{{#str}} lemmais, vocabtool_dictionary, {{lemma}} {{/str}}</p>
    {{/showlemma}}
    {{^hassenses}}
    <p class="text-muted mb-1">{{#str}} noentry, vocabtool_dictionary {{/str}}</p>
    {{/hassenses}}
    {{#senses}}
    <div class="vocabtool_dictionary_sense card mb-2{{#isrejected}} vocabtool_dictionary_rejected{{/isrejected}}">
        <div class="card-body p-2">
            <div class="vocabtool_dictionary_item d-flex flex-wrap align-items-center">
                <span class="mr-2 me-2">
                    <span class="font-weight-bold fw-bold">{{sensenum}}.</span>
                    <em>{{posname}}</em>
                    <span class="vocabtool_dictionary_text">{{text}}</span>
                    {{#level}}<span class="badge badge-secondary bg-secondary">{{level}}</span>{{/level}}
                </span>
                {{> vocabtool_dictionary/item_status }}
            </div>

            {{#hasdefinitions}}
            <h6 class="mt-2 mb-1">{{#str}} definitions, vocabtool_dictionary {{/str}}</h6>
            <ul class="list-unstyled ml-3 ms-3 mb-1">
                {{#definitions}}
                <li class="vocabtool_dictionary_item d-flex flex-wrap align-items-center{{#isrejected}} vocabtool_dictionary_rejected{{/isrejected}}">
                    <span class="vocabtool_dictionary_text mr-2 me-2">{{text}}
                        {{#level}}<span class="badge badge-secondary bg-secondary">{{level}}</span>{{/level}}</span>
                    {{> vocabtool_dictionary/item_status }}
                </li>
                {{/definitions}}
            </ul>
            {{/hasdefinitions}}

            {{#hasglosses}}
            <h6 class="mt-2 mb-1">{{#str}} glosses, vocabtool_dictionary {{/str}}</h6>
            <ul class="list-unstyled ml-3 ms-3 mb-1">
                {{#glosses}}
                <li class="vocabtool_dictionary_item d-flex flex-wrap align-items-center{{#isrejected}} vocabtool_dictionary_rejected{{/isrejected}}">
                    <span class="mr-2 me-2"><span class="text-muted">{{langname}}:</span>
                        <span class="vocabtool_dictionary_text">{{text}}</span></span>
                    {{> vocabtool_dictionary/item_status }}
                </li>
                {{/glosses}}
            </ul>
            {{/hasglosses}}

            {{#hassamples}}
            <h6 class="mt-2 mb-1">{{#str}} samples, vocabtool_dictionary {{/str}}</h6>
            <ul class="list-unstyled ml-3 ms-3 mb-1">
                {{#samples}}
                <li class="mb-1{{#isrejected}} vocabtool_dictionary_rejected{{/isrejected}}">
                    <div class="vocabtool_dictionary_item d-flex flex-wrap align-items-center">
                        <span class="vocabtool_dictionary_text mr-2 me-2">{{text}}
                            {{#form}}<span class="text-muted small">({{form}})</span>{{/form}}</span>
                        {{> vocabtool_dictionary/item_status }}
                    </div>
                    {{#hastranslations}}
                    <ul class="list-unstyled ml-3 ms-3">
                        {{#translations}}
                        <li class="vocabtool_dictionary_item d-flex flex-wrap align-items-center small{{#isrejected}} vocabtool_dictionary_rejected{{/isrejected}}">
                            <span class="mr-2 me-2"><span class="text-muted">{{langname}}:</span>
                                <span class="vocabtool_dictionary_text">{{text}}</span></span>
                            {{> vocabtool_dictionary/item_status }}
                        </li>
                        {{/translations}}
                    </ul>
                    {{/hastranslations}}
                </li>
                {{/samples}}
            </ul>
            {{/hassamples}}
        </div>
    </div>
    {{/senses}}
</div>
